# Copy this file to .env and adjust.
#
#   cp frontend/.env.example frontend/.env

# Base URL of the FastAPI backend.
VITE_API_BASE_URL=http://localhost:8000

# Must match CYBER_SURAKSHYA_API_KEY in the backend .env, or every request is
# rejected with 403.
#
# Vite inlines this into the built bundle, so it is visible to anyone who can
# load the dashboard. It authenticates the dashboard to a loopback-bound
# backend; it is not a user credential and must never be reused as one.
VITE_API_KEY=change-me-to-match-the-backend
