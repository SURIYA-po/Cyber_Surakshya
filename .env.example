# Copy to .env and fill in. `.env` is gitignored and loaded automatically by
# app.py at startup, so credentials travel with the project instead of
# depending on the right `export` in the right terminal.
#
#   cp .env.example .env
#
# Generate real passwords with:  openssl rand -base64 32
# The values below match the DEVELOPMENT placeholders in docker/redis/users.acl.
# Change both sides before this leaves your machine.

# ── API authentication (REQUIRED) ────────────────────────────────────────────
# Protects every endpoint under the authenticated router via the X-API-Key
# header. app.py REFUSES TO START without it -- starting with a known-public
# credential is worse than not starting.
#
# Generate one:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# Set the SAME value as VITE_API_KEY in frontend/.env, or the dashboard gets
# 403 on every request.
CYBER_SURAKSHYA_API_KEY=change-me-run-the-command-above

# ── Redis (ingestion stream) ─────────────────────────────────────────────────
# Redis disables its anonymous `default` user, so every client must
# authenticate. Without these the ingestion layer reports
# "Redis is unreachable: Authentication required."

# Producer identity — capture side. Can publish flows; cannot read the stream.
INGESTION_REDIS_PRODUCER_USERNAME=cs-producer
INGESTION_REDIS_PRODUCER_PASSWORD=dev-producer-password-change-me

# Consumer identity — pipeline side. Consumes, acknowledges, reclaims.
INGESTION_REDIS_CONSUMER_USERNAME=cs-consumer
INGESTION_REDIS_CONSUMER_PASSWORD=dev-consumer-password-change-me

# Fallback used for health checks and any connection without a specific role.
INGESTION_REDIS_USERNAME=cs-observer
INGESTION_REDIS_PASSWORD=dev-observer-password-change-me

# ── Optional overrides ───────────────────────────────────────────────────────
# INGESTION_POLICY_PATH=config/ingestion_policy.yaml
# RESPONSE_POLICY_PATH=config/response_policy.yaml
# MEMORY_DB_PATH=memory_metadata.db
# MEMORY_QDRANT_PATH=qdrant_db
